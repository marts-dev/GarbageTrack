# Copy to .env and adjust for your environment.
APP_NAME=GarbageTrack
DEBUG=false
API_V1_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=garbagetrack
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 bytes; the app refuses to start with a shorter key.
JWT_SECRET_KEY=REPLACE-ME-with-secrets-token-urlsafe-32-output
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Seed an admin user on first boot (only when the users collection is empty).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# JSON list of allowed browser origins, e.g. '["http://localhost:3000"]'
CORS_ORIGINS=[]
